# Only public client-side values belong here. Never add a service-role key or database password.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may use this instead of the publishable key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sample products/customers/sales are development-only. Set false when testing production data.
EXPO_PUBLIC_ENABLE_DEVELOPMENT_SEED=false
